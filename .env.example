# Server-only template; configure the Rust service outside the public webroot.
APP_ENV=production
# Domain deliberately undecided. Required before enabling production auth.
APP_URL=
# Loopback address and operator-selected port, e.g. 127.0.0.1:<port>
API_BIND=
RUST_LOG=info
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
# Absolute private directory outside repository and webroot.
STORAGE_PATH=
AUTH_MAX_FAILED_ATTEMPTS=
AUTH_LOCKOUT_SECONDS=
# IP limiter policy also requires backend configuration before production.
AUTH_IP_MAX_ATTEMPTS=
AUTH_IP_WINDOW_SECONDS=
SESSION_COOKIE_NAME=openecad_session
SESSION_LIFETIME_SECONDS=
WEBAUTHN_RP_ID=
WEBAUTHN_RP_ORIGIN=
# Encryption key supplied via protected server secret management, not Vite.
TOTP_ENCRYPTION_KEY=

# Frontend public configuration (Vite reads v0-frontend/.env.* or exported env).
VITE_OPENECAD_API_BASE=/api

# Trusted optional deployment hooks; exported by /srv/repos.sh.
OPENECAD_BACKEND_BUILD_CMD=
OPENECAD_MIGRATION_CHECK_CMD=
OPENECAD_MIGRATE_CMD=
OPENECAD_BACKEND_RESTART_CMD=
OPENECAD_HEALTHCHECK_URL=
